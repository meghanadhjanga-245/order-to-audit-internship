# Order-to-Audit System — Environment Variables Example
# Copy this file to .env for custom production/staging configuration.
# For local development with run.bat or run.ps1, defaults work out of the box.

# Security key (generate a random string for production)
SECRET_KEY=dev-only-order-to-audit-prototype-key-change-me

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma-separated domains or IP addresses)
ALLOWED_HOSTS=localhost,127.0.0.1,order-to-audit.onrender.com

# CSRF Trusted Origins (comma-separated HTTPS origins for web forms)
CSRF_TRUSTED_ORIGINS=https://order-to-audit.onrender.com,http://localhost:8000

# Server port (defaults to 8000)
PORT=8000
